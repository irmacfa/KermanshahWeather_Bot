# Telegram bot
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
BOT_OWNER_ID=

# Optional: comma-separated SOCKS5 proxies, tried in order at startup.
# Keep real credentials in the server's private .env file; never commit them.
TELEGRAM_PROXY_URLS=socks5://USERNAME:PASSWORD@api.azirlink.net:443,socks5://USERNAME:PASSWORD@api.nirvana-smoke.com:443,socks5://USERNAME:PASSWORD@panel.nirvana-smoke.com:8443,socks5://USERNAME:PASSWORD@panel.azirlink.net:8443

# Optional legacy single-proxy setting (used only when TELEGRAM_PROXY_URLS is empty)
# TELEGRAM_PROXY_URL=socks5://USERNAME:PASSWORD@proxy.example.com:1080

# Platform: telegram or bale
BOT_PLATFORM=telegram
